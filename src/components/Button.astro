---
interface Props {
  label: string
  href: string
  variant?: 'primary' | 'secondary' | 'ghost'
  size?: 'default' | 'large'
}

const { label, href, variant = 'primary', size = 'default' } = Astro.props as Props

const baseClasses = 'inline-block rounded-md font-medium transition'

const sizeClasses = size === 'large'
  ? 'px-8 py-4 text-sm tracking-wide'
  : 'px-5 py-3 text-sm'

const variantClasses = {
  primary: 'bg-stone-900 text-stone-50 hover:bg-stone-800',
  secondary: 'border border-stone-300 text-stone-900 hover:border-stone-900',
  ghost: 'text-stone-500 hover:text-stone-900',
}[variant]
---

<a href={href} class={`${baseClasses} ${sizeClasses} ${variantClasses}`}>
  {label}
</a>