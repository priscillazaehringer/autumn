---
import Button from './Button.astro'
interface Props {
  eyebrow?: string
  heading: string
  subheading?: string
  buttonLabel: string
  buttonHref?: string
  inquireKey?: string
}
const { eyebrow, heading, subheading, buttonLabel, buttonHref, inquireKey } = Astro.props as Props
---
<section class="max-w-5xl mx-auto px-6 py-32 text-center">
  {eyebrow ? (
    <p class="text-xs uppercase tracking-[0.2em] text-stone-500 mb-6">— {eyebrow}</p>
  ) : null}
  <h2 class="font-serif text-5xl md:text-7xl mb-6 leading-[0.95] tracking-tight font-normal" set:html={heading}></h2>
  {subheading ? (
    <p class="text-lg text-stone-600 mb-10">{subheading}</p>
  ) : null}

  {inquireKey ? (
    <button
      type="button"
      data-inquire={inquireKey}
      class="inline-flex items-center gap-2 px-8 py-4 bg-stone-900 text-stone-50 rounded-md text-base font-medium hover:bg-stone-800 transition"
    >
      {buttonLabel}
      <span>→</span>
    </button>
  ) : buttonHref ? (
    <Button label={buttonLabel} href={buttonHref} size="large" />
  ) : null}
</section>