---
import BaseLayout from '../layouts/BaseLayout.astro'
import { sanityClient, urlFor } from '../lib/sanity.js'

// ---------- POLAROID FAVORITES ----------
// Hand-picked slugs from Sanity — order here drives display order on the page.
// Captions are hand-written below (NOT pulled from Sanity titles) so they stay short + warm.
const POLAROIDS = [
  { slug: 'kewanee-prairie-chicken-arts-festival', caption: 'Kewanee' },
  { slug: 'lets-chalk-monticello',                 caption: "Let's Chalk Monticello" },
  { slug: 'chalkfest',                             caption: 'Chalkfest' },
  { slug: 'chalk-the-walk',                        caption: 'Chalk the Walk, Mt. Vernon' },
]

const polaroidSlugs = POLAROIDS.map((p) => p.slug)
const fetched = await sanityClient.fetch(
  `*[_type == "project" && slug.current in $slugs]{
    _id, title, "slug": slug.current, heroImage
  }`,
  { slugs: polaroidSlugs }
)

// Reassemble in our chosen order, attach captions, build image URLs.
const polaroids = POLAROIDS.map((p) => {
  const project = fetched.find((f) => f.slug === p.slug)
  if (!project) return null
  return {
    slug: p.slug,
    caption: p.caption,
    title: project.title,
    imgUrl: project.heroImage
      ? urlFor(project.heroImage).width(800).height(800).fit('crop').url()
      : null,
  }
}).filter(Boolean)
---

<BaseLayout title="About — Autumn Z Art" description="Hi, I'm Autumn. Self-taught chalk, mural, and pet-portrait artist based in Cedar Rapids, Iowa.">

  <section class="reveal relative">
    <div class="md:grid md:grid-cols-2 md:min-h-[85vh]">

      <!-- Text column: stone-50 background, content
           anchored toward the right edge so it sits
           close to the video without crossing it. -->
      <div class="bg-stone-50 flex items-center px-6 md:px-12 lg:px-20 py-16 md:py-20 order-2 md:order-1">
        <div class="max-w-md md:ml-auto">
          <p class="eyebrow mb-8">About</p>
          <p class="pullquote mb-10">
            Hi, I'm Autumn.
          </p>
          <p class="body-prose">
            From May through October, you can find me somewhere with a box of chalk, twenty hours deep into a piece that'll be gone by Monday.
          </p>
        </div>
      </div>

      <!-- Video column: full-bleed on its own half.
           autoplay + muted + loop + playsinline = ambient
           background video that works on every browser
           including iOS Safari. Poster shows while loading. -->
      <div class="relative bg-stone-200 aspect-[4/3] md:aspect-auto overflow-hidden order-1 md:order-2">
<video
  src="https://res.cloudinary.com/dztnasb08/video/upload/q_auto/f_auto/v1778120506/about_autumn_ortp8i.mp4"
  poster="https://res.cloudinary.com/dztnasb08/image/upload/q_auto/f_auto/v1778119819/galena_chozmw.jpg"
  class="absolute inset-0 w-full h-full object-cover"
  autoplay
  loop
  muted
  playsinline
  preload="metadata"
  aria-label="Autumn at work — Maple Grove"
>
  <img src="https://res.cloudinary.com/dztnasb08/image/upload/q_auto/f_auto/v1778119819/galena_chozmw.jpg" alt="Autumn at work — Maple Grove" class="absolute inset-0 w-full h-full object-cover" />
</video>
      </div>

    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-24 md:py-32 reveal">
    <div class="grid grid-cols-12 gap-8 md:gap-16 items-start">
      <div class="col-span-12 md:col-span-5 md:sticky md:top-24">
        <div class="relative inline-block w-full max-w-sm mx-auto md:max-w-none">
          <div class="absolute bg-gold-100 rounded-md" style="top: 20px; left: 20px; right: -20px; bottom: -20px;" aria-hidden="true"></div>
          <figure class="relative aspect-[4/5] bg-stone-200 rounded-md overflow-hidden shadow-[0_20px_50px_-20px_rgba(28,25,23,0.25)]">
            <img src="https://res.cloudinary.com/dztnasb08/image/upload/q_auto/f_auto/v1778119827/Autumn-Zaehringer-scaled_uuzmbb.jpg" alt="Autumn Zaehringer" class="w-full h-full object-cover" />
          </figure>
        </div>
      </div>
      <div class="col-span-12 md:col-span-7 md:pt-4">
        <div class="body-prose space-y-6">
          <p>
  I started drawing as a kid and never really stopped. The chalk thing came later. My first festival was in 2017, and I had no idea what I was doing. <em>Walked away with no awards, but I was hooked anyway.</em>
</p>
<p>
  Since then it's been festivals, windows, murals, and pet portraits at my kitchen table. Being self-taught means most of what I know came from making mistakes in front of strangers. That's part of what I like about chalk. It rains, the piece washes away, and the next weekend gives you a chance to make something better.
</p>
<p>
  I work across chalk, oil, ink, and digital. The medium shifts depending on the project, though the obsession with making something a person stops to look at stays the same.
</p>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-stone-100 border-y border-stone-200 reveal overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16 md:mb-20">
        <div>
          <p class="eyebrow mb-4">A few favorites</p>
          <h2 class="h2-section max-w-xl">Pulled from the portfolio.</h2>
        </div>
        <a href="/work" class="text-sm text-gold-700 hover:text-gold-900 underline underline-offset-4 font-medium whitespace-nowrap self-start md:self-end">
          See all work →
        </a>
      </div>

      <div class="polaroid-board relative mx-auto" aria-label="Selected portfolio images">
        {polaroids.map((p, i) => (
          <a
            href={`/work?project=${p.slug}`}
            class={`polaroid polaroid-${i + 1}`}
            aria-label={`View ${p.title}`}
          >
            <div class="polaroid-img">
              {p.imgUrl ? (
                <img src={p.imgUrl} alt={p.title} loading="lazy" />
              ) : (
                <div class="w-full h-full stripe-placeholder"></div>
              )}
            </div>
            <figcaption>{p.caption}</figcaption>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-24 md:py-32 reveal">
    <div class="mb-14 md:mb-20">
      <p class="eyebrow mb-4">Festivals & events</p>
      <h2 class="h2-section max-w-2xl">Some places I've shown up.</h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-x-6 gap-y-10 md:gap-x-12 items-center justify-items-center">
      <div class="logo-cell">
        <img src="https://res.cloudinary.com/dztnasb08/image/upload/q_auto/f_auto/v1778119816/chalkthewalk_ygjd7b.png" alt="Mt. Vernon Chalk the Walk" />
      </div>
      <div class="logo-cell">
        <img src="https://res.cloudinary.com/dztnasb08/image/upload/q_auto/f_auto/v1778119828/chalkartfest_tlopqu.png" alt="Chalk Art Fest" />
      </div>
      <div class="logo-cell">
        <img src="https://res.cloudinary.com/dztnasb08/image/upload/q_auto/f_auto/v1778119817/chalkfest_butqhz.png" alt="Chalkfest" />
      </div>
      <div class="logo-cell">
        <img src="https://res.cloudinary.com/dztnasb08/image/upload/q_auto/f_auto/v1778119818/herkyonparade_gcehzs.png" alt="Herky on Parade" />
      </div>
      <div class="logo-cell col-span-2 md:col-span-1">
        <img src="https://res.cloudinary.com/dztnasb08/image/upload/q_auto/f_auto/v1778119825/temeart_pow3tk.svg" alt="Tempe Festival of the Arts" />
      </div>
    </div>

    <p class="mt-16 text-sm text-stone-500 max-w-md">
      See the <a class="text-gold-700 underline underline-offset-4 hover:text-gold-900" href="/">homepage</a> for the full 2026 schedule.
    </p>
  </section>

  <section class="bg-gold-50 reveal">
    <div class="max-w-6xl mx-auto px-6 py-24 md:py-32">
      <div class="max-w-2xl mx-auto text-center">
        <p class="eyebrow mb-6">Currently booking 2026</p>
        <h2 class="h2-section mb-6 max-w-md mx-auto">Got something in mind?</h2>
        <p class="body-prose mb-10">
          Reach out anytime. Chalk, murals, windows, portraits, and everything in between.
        </p>
        <button type="button" data-inquire="general" class="inline-block px-8 py-4 bg-stone-900 text-stone-50 rounded-md text-sm font-medium hover:bg-stone-800 transition cursor-pointer border-0">
          Say hi →
        </button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Pull-quote — hero opener */
  .pullquote {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    font-size: 3rem;
  }
  @media (min-width: 768px) { .pullquote { font-size: 4.5rem; } }
  @media (min-width: 1024px) { .pullquote { font-size: 5.5rem; } }
  @media (min-width: 1280px) { .pullquote { font-size: 6rem; } }

  /* Stripe placeholder */
  .stripe-placeholder {
    background-image: repeating-linear-gradient(135deg, rgba(28,25,23,0.04) 0 14px, rgba(28,25,23,0.08) 14px 28px);
    background-color: #f5f5f4;
  }

  /* ===== Polaroid scatter ===== */
  .polaroid-board {
    position: relative;
    min-height: 560px;
    max-width: 900px;
  }
  @media (min-width: 768px) {
    .polaroid-board { min-height: 640px; }
  }
  .polaroid {
    background: #fefdf9;
    padding: 14px 14px 44px;
    box-shadow:
      0 1px 2px rgba(28,25,23,0.06),
      0 12px 28px -8px rgba(28,25,23,0.18),
      0 2px 6px rgba(28,25,23,0.08);
    transition: transform 500ms cubic-bezier(0.22,1,0.36,1), box-shadow 500ms;
    text-decoration: none;
    display: block;
  }
  .polaroid:hover {
    transform: rotate(0deg) translateY(-6px) scale(1.02) !important;
    z-index: 10;
    box-shadow: 0 24px 48px -12px rgba(28,25,23,0.28);
  }
  .polaroid-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #e7e5e4;
    overflow: hidden;
  }
  .polaroid-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .polaroid figcaption {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: 1rem;
    color: #57534e;
    text-align: center;
    margin-top: 14px;
    letter-spacing: 0.01em;
  }

  /* Mobile: 2-col loose grid with rotation */
  .polaroid-1, .polaroid-2, .polaroid-3, .polaroid-4 {
    width: 46%;
    display: inline-block;
    margin: 1%;
  }
  .polaroid-1 { transform: rotate(-3deg); }
  .polaroid-2 { transform: rotate(2.5deg); }
  .polaroid-3 { transform: rotate(-1.5deg); }
  .polaroid-4 { transform: rotate(3deg); }

  /* Desktop: absolute-positioned scatter */
  @media (min-width: 768px) {
    .polaroid-1, .polaroid-2, .polaroid-3, .polaroid-4 {
      position: absolute;
      width: 280px;
      margin: 0;
      display: block;
    }
    .polaroid-1 { top: 0;     left: 2%;   transform: rotate(-5deg); width: 300px; }
    .polaroid-2 { top: 30px;  left: 32%;  transform: rotate(3deg);  width: 260px; z-index: 2; }
    .polaroid-3 { top: 220px; left: 16%;  transform: rotate(-2deg); width: 240px; z-index: 3; }
    .polaroid-4 { top: 140px; right: 4%;  transform: rotate(4deg);  width: 290px; }
  }

  /* ===== Festival logo wall ===== */
  .logo-cell {
    width: 100%;
    max-width: 200px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: grayscale(100%);
    opacity: 0.85;
    transition: filter 400ms, opacity 400ms;
  }
.logo-cell:hover { filter: grayscale(0%); opacity: 1; }
  .logo-cell img { max-width: 100%; max-height: 100%; object-fit: contain; }
</style>

