---
import BaseLayout from '../layouts/BaseLayout.astro'
import { sanityClient, urlFor } from '../lib/sanity.js'

// Pull upcoming portrait slots, only showing future-dated ones
const todayISO = new Date().toISOString().split('T')[0]

const slots = await sanityClient.fetch(
  `*[_type == "portraitSlot" && status != "hidden" && shipDate >= $today] | order(shipDate asc) {
    _id,
    shipDate,
    status,
    checkoutUrl
  }`,
  { today: todayISO }
)

// ---- Launch offer ----------------------------------------------------------
// While LAUNCH_MODE is true, every available date is the local, hand-delivered
// launch deal at LAUNCH_PRICE (shown struck through against REGULAR_PRICE).
// When you start shipping nationally at the regular price, flip LAUNCH_MODE to
// false — the badge, the "Launch" pills, and the discount all switch off, and
// dates revert to REGULAR_PRICE. Just keep your Stripe links in sync with these.
const LAUNCH_MODE = true
const LAUNCH_PRICE = 57
const REGULAR_PRICE = 147

// Format each slot for display.
const slotsForDisplay = slots.map((s) => {
  const date = new Date(s.shipDate + 'T12:00:00') // noon avoids timezone day-shift
  const monthShort = date.toLocaleDateString('en-US', { month: 'short' })
  const day = date.getDate()
  return {
    id: s._id,
    shipLabel: `Ready ${monthShort} ${day}`,
    status: s.status,
    checkoutUrl: s.checkoutUrl || '#',
    isLaunch: LAUNCH_MODE,
    price: LAUNCH_MODE ? LAUNCH_PRICE : REGULAR_PRICE,
  }
})

// Launch-offer summary used by the hero badge + booking note.
const hasLaunchSlots = LAUNCH_MODE && slotsForDisplay.some((s) => s.status !== 'booked')
const launchPrice = LAUNCH_PRICE

const features = [
  {
    title: 'High-quality oil paints',
    body: 'No prints, no digital tricks. Each portrait is hand-painted with high-quality oil paints on wrapped canvas.',
  },
  {
    title: 'Painted from your photo',
    body: "Custom to your pet and all their quirks — different-colored eyes, the exact color of their coat, that one ear that won't sit straight. Whatever makes them them.",
  },
  {
    title: 'Ready to hang',
    body: 'Wrapped canvas arrives ready to display. No frame needed unless you want one.',
  },
]

// Gallery pulls from the work catalog — projects filed under the "portrait"
// medium (your "Pet portrait" category). One hero image per project, so each
// tile is a different animal. Add portraits in the Studio to grow this grid.
const portraitProjects = await sanityClient.fetch(
  `*[_type == "project" && medium == "portrait" && defined(heroImage) && slug.current != "simba"] | order(year desc, _createdAt desc) [0...12] {
    _id,
    title,
    description,
    year,
    location,
    heroImage
  }`
)

const portraitsForDisplay = portraitProjects.map((p) => ({
  id: p._id,
  title: p.title || 'Pet portrait',
  description: p.description || null,
  year: p.year || null,
  location: p.location || null,
  // 4:5 thumb for the carousel; larger, uncropped image for the lightbox.
  thumbUrl: urlFor(p.heroImage).width(700).height(875).fit('crop').url(),
  fullUrl: urlFor(p.heroImage).width(1400).fit('max').url(),
  alt: p.title ? `Hand-painted oil portrait — ${p.title}` : 'Hand-painted oil pet portrait',
}))

const steps = [
  { num: '01', text: 'Pick a date below' },
  { num: '02', text: 'Check out and pay' },
  { num: '03', text: "I'll email you for your pet's photos and story" },
  { num: '04', text: 'I paint your pet.' },
  { num: '05', text: "Your portrait's ready on the date you picked" },
]

const faqs = [
  {
    q: 'What kind of photo should I send?',
    a: "After you book, I'll ask for 3 to 5 photos of your pet. Natural light works best. A mix is helpful: a full-body shot, a close-up of the face, and any photos that capture their personality. Phone photos are fine. I'll let you know if I need more.",
  },
  {
    q: 'Can you paint more than one pet?',
    a: 'Not on this size. The 5x7 canvas keeps each portrait detailed and personal, which means one animal per painting. If you have multiple pets, each one gets its own portrait.',
  },
  {
    q: 'What size is the canvas?',
    a: '5x7 inches on wrapped canvas. The wrapped edges mean it can hang as-is — no frame required, though it looks great in one if that\'s your vibe. About the size of a postcard.',
  },
  {
    q: 'How long does it take?',
    a: "About a week. I paint your pet during the week leading up to the date you picked, and your portrait's ready to go — for pickup, delivery, or the mail — by then.",
  },
  {
    q: "What if I don't love it?",
    a: "Each portrait is hand-painted just for you, so I don't offer refunds. But if something feels off when you receive it — wrong angle, missing detail, anything — let me know within 7 days and I'll do my best to make it right.",
  },
  {
    q: 'How do I get my portrait?',
    a: "Right now I'm focused on my local area around Cedar Rapids — local pickup or hand-delivery — with US shipping rolling out from there. I'll sort out the best option with you after you book. International shipping isn't available yet, but if you're outside the US, get in touch and we'll see what's possible.",
  },
]
---

<BaseLayout title="Pet portraits — Autumn Z Art" description="Hand-painted oil pet portraits. One animal, one week, one painting at a time. $147.">

  <!-- HERO -->
  <section class="relative w-full overflow-hidden bg-stone-900">
    <!-- Ambient background reel, dimmed under gradients so the lower-res
         footage reads as texture, not the focal point. Poster is the video's
         first Cloudinary frame, so nothing 404s. -->
    <video
      id="hero-video"
      poster="https://res.cloudinary.com/dztnasb08/video/upload/q_auto/f_auto/so_0/v1780536200/Untitled_design_3_eaeoeg.jpg"
      class="absolute inset-0 w-full h-full object-cover opacity-80"
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline
      preload="auto"
      aria-hidden="true"
    >
      <source src="https://res.cloudinary.com/dztnasb08/video/upload/q_auto/f_auto/v1780536200/Untitled_design_3_eaeoeg.mp4" type="video/mp4" />
    </video>

    <div class="absolute inset-0 bg-gradient-to-r from-stone-900/85 via-stone-900/55 to-stone-900/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-stone-900/75 via-transparent to-stone-900/20"></div>

    <div class="relative max-w-6xl mx-auto px-6 py-24 md:py-36 min-h-[70vh] md:min-h-[82vh] flex flex-col justify-end">
      <p class="text-xs uppercase tracking-[0.2em] text-gold-300 font-medium mb-6">Pet portraits</p>
      <h1 class="h1-display mb-6 text-stone-50 max-w-[18ch]">
        Hand-painted pet portraits.
      </h1>
      <p class="hero-lede mb-8 text-stone-200 max-w-xl">
        For the pet you love. Hand-painted in oil on canvas.
      </p>
      {hasLaunchSlots && (
        <p class="inline-flex items-center gap-2 self-start bg-gold-100 text-gold-900 rounded-full pl-3 pr-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider mb-8">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gold-600"></span>
          Launch offer — first 7 portraits ${launchPrice}, Cedar Rapids, Iowa area
        </p>
      )}
      <a href="#pick-your-date" class="inline-block self-start px-6 py-3.5 bg-stone-50 text-stone-900 rounded-md text-sm font-medium hover:bg-stone-200 transition text-center">
        Pick a date →
      </a>
    </div>
  </section>

  <!-- GALLERY — auto-scrolling carousel, click a portrait to open the lightbox -->
  {portraitsForDisplay.length > 0 && (
    <Fragment>
      <section class="bg-stone-100 py-20 md:py-28">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-12 md:mb-16">
            <p class="text-xs uppercase tracking-[0.2em] text-stone-500 mb-4">Recent portraits</p>
            <h2 class="font-serif text-3xl md:text-4xl font-normal leading-tight">
              Some of the animals I've painted.
            </h2>
            <p class="text-sm text-stone-500 mt-4">Tap any portrait to take a closer look.</p>
          </div>
        </div>

        <!-- Marquee: ~3 in view on desktop, scrolls right on its own, pauses on hover.
             The list is duplicated so the loop is seamless; clones are hidden from
             assistive tech. -->
        <div id="portrait-marquee" class="portrait-marquee" aria-label="Recent pet portraits — scrolling gallery">
          <div class="portrait-track">
            {[...portraitsForDisplay, ...portraitsForDisplay].map((p, i) => (
              <button
                type="button"
                class="portrait-card"
                data-portrait-id={p.id}
                aria-label={`View portrait — ${p.title}`}
                aria-hidden={i >= portraitsForDisplay.length ? 'true' : undefined}
                tabindex={i >= portraitsForDisplay.length ? -1 : undefined}
              >
                <img src={p.thumbUrl} alt={p.alt} loading="lazy" />
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- PORTRAIT LIGHTBOX -->
      <div
        id="portrait-lightbox"
        class="hidden fixed inset-0 z-[60] bg-stone-900/90 backdrop-blur-sm items-center justify-center p-4 md:p-12"
        role="dialog"
        aria-modal="true"
        aria-labelledby="portrait-lightbox-title"
      >
        <div id="portrait-lightbox-card" class="bg-stone-50 rounded-md max-w-3xl w-full max-h-[90vh] overflow-y-auto relative">
          <button
            id="portrait-lightbox-close"
            type="button"
            aria-label="Close"
            class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-stone-50/90 border border-stone-200 flex items-center justify-center text-stone-700 hover:bg-stone-900 hover:text-stone-50 hover:border-stone-900 transition"
          >
            <svg width="14" height="14" viewBox="0 0 14 14"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </button>

          <div id="portrait-lightbox-hero" class="bg-stone-100 flex items-center justify-center"></div>

          <div class="p-6 md:p-10">
            <p id="portrait-lightbox-eyebrow" class="text-xs uppercase tracking-[0.2em] text-gold-600 font-medium mb-3"></p>
            <h2 id="portrait-lightbox-title" class="font-serif text-3xl md:text-4xl leading-tight mb-4 font-normal"></h2>
            <p id="portrait-lightbox-description" class="hidden text-base text-stone-700 leading-relaxed max-w-2xl"></p>
          </div>
        </div>
      </div>
    </Fragment>
  )}

  <!-- WHAT YOU GET -->
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
    <div class="text-center mb-12 md:mb-16">
      <p class="text-xs uppercase tracking-[0.2em] text-stone-500 mb-4">What you get</p>
         <h2 class="h2-section">
        A real painting, made by hand.
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 max-w-5xl mx-auto">
      {features.map((f) => (
        <div class="text-center bg-stone-50 border border-stone-200 rounded-xl p-8 md:p-10">
          <h3 class="h3-card mb-3">{f.title}</h3>
          <p class="text-sm text-stone-600 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
    <div class="text-center mb-12 md:mb-16">
      <p class="text-xs uppercase tracking-[0.2em] text-stone-500 mb-4">How it works</p>
      <h2 class="font-serif text-3xl md:text-4xl font-normal leading-tight">
        Five steps from photo to your door.
      </h2>
    </div>
    <div class="relative grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-0 max-w-5xl mx-auto">
      <!-- Continuous rail behind the circles on mobile (vertical timeline). -->
      <span class="md:hidden absolute left-5 top-5 bottom-5 w-px bg-gold-200 -translate-x-1/2" aria-hidden="true"></span>
      {steps.map((s, i) => (
        <div class="relative flex md:block items-start gap-4 md:gap-0 text-left md:text-center md:px-2">
          {/* Horizontal connector to the next step on desktop. */}
          {i < steps.length - 1 && (
            <span class="hidden md:block absolute top-5 left-1/2 w-full h-px bg-gold-200" aria-hidden="true"></span>
          )}
          <div class="relative z-10 flex-shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-full bg-gold-100 text-gold-800 font-serif text-base md:mx-auto md:mb-4">{s.num}</div>
          <p class="text-sm text-stone-700 leading-relaxed pt-2 md:pt-0">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PICK YOUR DATE -->
  <section id="pick-your-date" class="bg-gold-50 py-24 md:py-32">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12 md:mb-16">
                <p class="eyebrow-gold mb-4">Booking</p>
        <h2 class="font-serif text-4xl md:text-5xl font-normal leading-tight mb-4">
          Pick a date.
        </h2>
        <p class="text-base text-stone-600 max-w-xl mx-auto leading-relaxed">
          Pick the date your portrait arrives. These are all custom pieces, so they do need a little lead time. Need it by a date that isn't listed? Email me at <a href="mailto:aezaehri@gmail.com" class="text-gold-700 underline underline-offset-4 hover:text-gold-900">aezaehri@gmail.com</a> and I'll see what I can do.
        </p>
      </div>

      {slotsForDisplay.length > 0 ? (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-10">
            {slotsForDisplay.map((slot) => {
              const isBooked = slot.status === 'booked'
              const isLaunch = slot.isLaunch
              return (
                <div class={`rounded-lg p-6 transition ${isBooked ? 'bg-stone-100 border border-stone-200' : isLaunch ? 'bg-stone-50 border border-gold-300 hover:border-gold-500' : 'bg-stone-50 border border-stone-200 hover:border-stone-900'}`}>
                  <div class="flex items-center justify-between mb-3">
                    <p class={`text-xs uppercase tracking-wider font-medium ${isBooked ? 'text-stone-400' : 'text-gold-700'}`}>
                      {isBooked ? 'Booked' : 'Available'}
                    </p>
                    {isLaunch && !isBooked && (
                      <span class="text-[10px] uppercase tracking-wider font-semibold text-gold-800 bg-gold-100 rounded-full px-2 py-0.5">Launch</span>
                    )}
                  </div>
                  <p class={`font-serif text-xl leading-tight ${isBooked ? 'text-stone-400' : 'text-stone-900'}`}>
                    {slot.shipLabel}
                  </p>
                  <p class={`mt-2 ${isBooked ? 'text-stone-400' : 'text-stone-900'}`}>
                    {isLaunch ? (
                      <>
                        <span class="line-through text-stone-400 text-sm mr-1.5">${REGULAR_PRICE}</span>
                        <span class="font-medium">${slot.price}</span>
                      </>
                    ) : (
                      <span class="font-medium">${slot.price}</span>
                    )}
                  </p>
                  {isLaunch && !isBooked && (
                    <p class="text-xs text-stone-500 mt-1 leading-relaxed">Cedar Rapids, Iowa area · hand-delivered, no shipping</p>
                  )}
                  {!isBooked ? (
                    <a href={slot.checkoutUrl} class="inline-block w-full text-center px-4 py-2.5 mt-5 bg-stone-900 text-stone-50 rounded-md text-sm font-medium hover:bg-stone-800 transition">
                      Book this date
                    </a>
                  ) : (
                    <p class="text-xs text-stone-400 text-center py-2.5 mt-5">Not available</p>
                  )}
                </div>
              )
            })}
          </div>

          <p class="text-center text-sm text-stone-600 max-w-xl mx-auto leading-relaxed">
            {hasLaunchSlots ? (
              <>Launch offer: the first 7 portraits are <span class="text-stone-900 font-medium">${launchPrice}</span> for the Cedar Rapids, Iowa and surrounding areas — hand-delivered, no shipping.</>
            ) : (
              <>${REGULAR_PRICE} per portrait. Includes local delivery or US shipping.</>
            )}
          </p>
        </>
      ) : (
        <div class="text-center py-12">
          <p class="font-serif text-2xl text-stone-700 mb-4">No upcoming dates available right now.</p>
          <p class="text-base text-stone-600 mb-6 max-w-md mx-auto">
            New dates open regularly. Get on the list and I'll email you when the next batch is bookable.
          </p>
          <button type="button" data-inquire="portraits" class="inline-block px-5 py-3 border border-stone-900 text-stone-900 rounded-md text-sm font-medium hover:bg-stone-900 hover:text-stone-50 transition cursor-pointer bg-transparent">
            Get notified →
          </button>
        </div>
      )}
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-6 py-20 md:py-28">
    <div class="text-center mb-12 md:mb-16">
      <p class="text-xs uppercase tracking-[0.2em] text-stone-500 mb-4">Questions</p>
      <h2 class="font-serif text-3xl md:text-4xl font-normal leading-tight">
        Things people often ask.
      </h2>
    </div>
    <div class="divide-y divide-stone-200 border-t border-b border-stone-200">
      {faqs.map((faq) => (
        <details class="group py-5">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h3 class="font-serif text-lg text-stone-900 pr-6">{faq.q}</h3>
            <span class="text-stone-400 group-open:rotate-45 transition-transform duration-200 text-2xl leading-none flex-shrink-0">+</span>
          </summary>
          <p class="text-sm text-stone-600 leading-relaxed mt-4 pr-10">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ABOUT -->
  <section class="bg-stone-100 py-20 md:py-28">
    <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-center">
      <div class="md:col-span-5">
        <div class="aspect-[4/5] overflow-hidden rounded-lg bg-stone-200">
          <img
            src="https://res.cloudinary.com/dztnasb08/image/upload/q_auto/f_auto/v1778119827/Autumn-Zaehringer-scaled_uuzmbb.jpg"
            alt="Autumn Zaehringer"
            class="w-full h-full object-cover"
            style="object-position: center 30%;"
          />
        </div>
      </div>
      <div class="md:col-span-7">
        <p class="text-xs uppercase tracking-[0.2em] text-stone-500 mb-4">About the artist</p>
        <h2 class="font-serif text-3xl md:text-4xl font-normal leading-tight mb-6">
          Hi, I'm Autumn.
        </h2>
        <!-- Bio in Autumn's words. -->
        <p class="text-base text-stone-700 leading-relaxed mb-4">
          I've been drawing for as long as I can remember. These days that means chalk events, murals, and window art, and of course pet portraits.
        </p>
        <p class="text-base text-stone-700 leading-relaxed mb-4">
          Pets are my favorite thing to paint. I'm always painting my own, and getting the exact tilt of an ear or the look in an eye right is the part I love most. That's what turns it into a portrait of <em>your</em> dog, not just some dog.
        </p>
        <p class="text-base text-stone-700 leading-relaxed">
          Fun fact: I also do pet portraits for Chewy.com, and at home I've got one dog, one cat, and a bearded dragon.
        </p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-gold-50 py-24 md:py-32">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="font-serif text-3xl md:text-4xl font-normal leading-snug mb-8">
        Slots fill up. If you've been thinking about it,<br class="hidden md:block"/> this is your sign.
      </h2>
      <a href="#pick-your-date" class="inline-block px-6 py-3.5 bg-stone-900 text-stone-50 rounded-md text-sm font-medium hover:bg-stone-800 transition">
        Pick a date →
      </a>
    </div>
  </section>

</BaseLayout>

<script is:inline define:vars={{ portraitsForDisplay }}>
  (function () {
    const PORTRAITS = portraitsForDisplay
    const byId = Object.fromEntries(PORTRAITS.map((p) => [p.id, p]))

    const lb = document.getElementById('portrait-lightbox')
    if (!lb) return // section not rendered (no portraits)

    const card = document.getElementById('portrait-lightbox-card')
    const hero = document.getElementById('portrait-lightbox-hero')
    const eyebrow = document.getElementById('portrait-lightbox-eyebrow')
    const title = document.getElementById('portrait-lightbox-title')
    const desc = document.getElementById('portrait-lightbox-description')

    function open(id) {
      const p = byId[id]
      if (!p) return

      hero.innerHTML = ''
      const img = document.createElement('img')
      img.src = p.fullUrl
      img.alt = p.alt
      img.className = 'w-full max-h-[70vh] object-contain'
      hero.appendChild(img)

      eyebrow.textContent = ['Oil on canvas', p.location, p.year].filter(Boolean).join(' · ')
      title.textContent = p.title

      if (p.description) {
        desc.textContent = p.description
        desc.classList.remove('hidden')
      } else {
        desc.classList.add('hidden')
      }

      lb.classList.remove('hidden')
      lb.classList.add('flex')
      document.body.style.overflow = 'hidden'
      card.scrollTop = 0
    }

    function close() {
      lb.classList.add('hidden')
      lb.classList.remove('flex')
      document.body.style.overflow = ''
    }

    document.querySelectorAll('.portrait-card').forEach((c) => {
      c.addEventListener('click', () => open(c.getAttribute('data-portrait-id')))
    })

    document.getElementById('portrait-lightbox-close').addEventListener('click', close)
    lb.addEventListener('click', (e) => { if (e.target === lb) close() })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lb.classList.contains('hidden')) close()
    })

    // On touch, pause the marquee briefly so taps land on the right portrait.
    const marquee = document.getElementById('portrait-marquee')
    const track = marquee && marquee.querySelector('.portrait-track')
    if (marquee && track) {
      let resumeTimer
      marquee.addEventListener('touchstart', () => {
        clearTimeout(resumeTimer)
        track.classList.add('is-paused')
      }, { passive: true })
      marquee.addEventListener('touchend', () => {
        resumeTimer = setTimeout(() => track.classList.remove('is-paused'), 1500)
      }, { passive: true })
    }
  })()
</script>

<style>
  /* ===== Recent portraits marquee ===== */
  .portrait-marquee {
    overflow: hidden;
    width: 100%;
  }
  .portrait-track {
    display: flex;
    width: max-content;
    padding-inline: 1.5rem;
    animation: portrait-scroll 50s linear infinite;
    will-change: transform;
  }
  /* Pause on hover, on keyboard focus, and (via JS) on touch. */
  .portrait-marquee:hover .portrait-track,
  .portrait-marquee:focus-within .portrait-track,
  .portrait-track.is-paused {
    animation-play-state: paused;
  }

  .portrait-card {
    flex: 0 0 auto;
    width: 76vw;
    max-width: 340px;
    margin-right: 1rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 0;
    padding: 0;
    background: #e7e5e4;
    cursor: pointer;
    position: relative;
  }
  @media (min-width: 640px) { .portrait-card { width: 42vw; } }
  @media (min-width: 1024px) { .portrait-card { width: 22rem; } }

  .portrait-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .portrait-card:hover img { transform: scale(1.05); }

  @keyframes portrait-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Respect reduced-motion: stop the auto-scroll, allow manual swipe instead. */
  @media (prefers-reduced-motion: reduce) {
    .portrait-marquee { overflow-x: auto; }
    .portrait-track { animation: none; }
  }
</style>

<script is:inline>
  // Nudge the hero reel to autoplay on mobile (iOS Safari blocks autoplay
  // unless muted + playsinline, and refuses entirely in Low Power Mode). We
  // force muted, attempt play, and retry on the first user gesture.
  (function () {
    var v = document.getElementById('hero-video')
    if (!v) return
    v.muted = true
    v.setAttribute('muted', '')
    function tryPlay() {
      var p = v.play()
      if (p && p.catch) p.catch(function () {})
    }
    tryPlay()
    var events = ['touchstart', 'pointerdown', 'scroll']
    function kick() {
      tryPlay()
      events.forEach(function (ev) { window.removeEventListener(ev, kick) })
    }
    events.forEach(function (ev) { window.addEventListener(ev, kick, { passive: true }) })
  })()
</script>
